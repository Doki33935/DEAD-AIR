 else if(Stage==3&&Now>Started+5.2f){double Elapsed=FMath::Fmod(Num(TEXT("AudioPhase"))-PhaseBefore+1.,1.)*Num(TEXT("BroadcastDuration"));Expect(Elapsed>1.6&&Elapsed<2.5,TEXT("Broadcast advances while OFF"));Run(TEXT("TogglePower"));Expect(Count()==1&&Flag(TEXT("Receiving")),TEXT("Power on does not rewind"));UE_LOG(LogTemp,Display,TEXT("RADIO LIVE VERIFY COMPLETE: %d checks, %d failures"),Checks,Failed);return false;}
