UEdGraphPin* V(UEdGraph* G,const TCHAR* N) { return Get(G,N)->FindPin(N); }
UEdGraphPin* Op(UEdGraph* G,const TCHAR* N,UEdGraphPin* A,UEdGraphPin* B=nullptr,const TCHAR* Number=nullptr) { auto C=Call(G,UKismetMathLibrary::StaticClass(),N); Link(A,Pin(C,TEXT("A"))); if(B)Link(B,Pin(C,TEXT("B"))); else if(Number)Def(C,TEXT("B"),Number); return Pin(C,TEXT("ReturnValue")); }
UEdGraphPin* Clamp(UEdGraph* G,UEdGraphPin* Value,const TCHAR* Min,const TCHAR* Max) { auto C=Call(G,UKismetMathLibrary::StaticClass(),TEXT("FClamp")); Link(Value,Pin(C,TEXT("Value"))); Def(C,TEXT("Min"),Min); Def(C,TEXT("Max"),Max); return Pin(C,TEXT("ReturnValue")); }
UEdGraphPin* PC(UEdGraph* G) { return Pin(Call(G,UGameplayStatics::StaticClass(),TEXT("GetPlayerController")),TEXT("ReturnValue")); }
UEdGraphPin* Lock(UEdGraph* G) { auto Distance=Op(G,TEXT("Subtract_DoubleDouble"),V(G,TEXT("FineFrequencyKHz")),V(G,TEXT("StationFrequencyKHz"))); auto Abs=Call(G,UKismetMathLibrary::StaticClass(),TEXT("Abs")); Link(Distance,Pin(Abs,TEXT("A"))); auto Near=Op(G,TEXT("LessEqual_DoubleDouble"),Pin(Abs,TEXT("ReturnValue")),V(G,TEXT("LockWidthKHz"))); return Op(G,TEXT("BooleanAND"),Near,V(G,TEXT("Powered"))); }
UK2Node_CallFunction* Invoke(UEdGraph* G,UEdGraphPin*& Exec,const TCHAR* Name) { auto C=Call(G,Radio->SkeletonGeneratedClass,Name); Link(Exec,Pin(C,TEXT("execute"))); Exec=Pin(C,TEXT("then")); return C; }
void Assign(UEdGraph* G,UEdGraphPin*& Exec,const TCHAR* Name,UEdGraphPin* Value=nullptr,const TCHAR* Default=nullptr) { auto S=Set(G,Name); if(Value)Link(Value,Pin(S,Name)); if(Default)Def(S,Name,Default); Link(Exec,Pin(S,TEXT("execute"))); Exec=Pin(S,TEXT("then")); }
// Bake extrema of the actual PCM recording, not a decorative oscillator.
float RecordingDuration=0;
UTexture2D* RecordingTexture() {
 TArray<uint8> Bytes;check(FFileHelper::LoadFileToArray(Bytes,*FPaths::ConvertRelativePathToFull(FPaths::ProjectDir()/TEXT("../Tools/RadioBuilder/Audio/RadioSignal.wav"))));
 FWaveModInfo W;check(W.ReadWaveInfo(Bytes.GetData(),Bytes.Num()));check(*W.pBitsPerSample==16);
 const int32 Channels=*W.pChannels, Frames=W.SampleDataSize/(Channels*2), Width=4096;
 RecordingDuration=float(Frames)/float(*W.pSamplesPerSec);check(RecordingDuration>0);
 auto Samples=reinterpret_cast<const int16*>(W.SampleDataStart);float Peak=1;
 for(int32 I=0;I<Frames*Channels;I++)Peak=FMath::Max(Peak,float(FMath::Abs(int32(Samples[I]))));
 TArray<FColor> Pixels;Pixels.SetNum(Width);
 for(int32 X=0;X<Width;X++) {
  int32 Lo=0,Hi=0;
  for(int32 I=(int64(X)*Frames/Width)*Channels;I<(int64(X+1)*Frames/Width)*Channels;I++){Lo=FMath::Min(Lo,int32(Samples[I]));Hi=FMath::Max(Hi,int32(Samples[I]));}
  Pixels[X]=FColor(FMath::RoundToInt((.5f+.48f*Lo/Peak)*255),FMath::RoundToInt((.5f+.48f*Hi/Peak)*255),0,255);
 }
 auto P=CreatePackage(TEXT("/Game/RadioExample/T_RadioSignalWaveform"));auto T=NewObject<UTexture2D>(P,TEXT("T_RadioSignalWaveform"),RF_Public|RF_Standalone);
 T->Source.Init(Width,1,1,1,TSF_BGRA8,reinterpret_cast<const uint8*>(Pixels.GetData()));T->SRGB=false;T->CompressionSettings=TC_VectorDisplacementmap;T->MipGenSettings=TMGS_NoMipmaps;T->AddressX=TA_Wrap;T->AddressY=TA_Clamp;T->Filter=TF_Bilinear;
 FAssetRegistryModule::AssetCreated(T);T->PostEditChange();Save(T);
 UE_LOG(LogTemp,Display,TEXT("RECORDING WAVEFORM: %d PCM frames, %.6f seconds, %d min/max bins"),Frames,RecordingDuration,Width);return T;
}
UMaterial* WaveMaterial() {
 auto Recording=RecordingTexture();
 auto P=CreatePackage(TEXT("/Game/RadioExample/M_RadioWaveform")); auto M=NewObject<UMaterial>(P,TEXT("M_RadioWaveform"),RF_Public|RF_Standalone); M->MaterialDomain=MD_UI; M->BlendMode=BLEND_Translucent;
 auto Constant=[&](float F){auto N=NewObject<UMaterialExpressionConstant>(M);N->R=F;M->Expressions.Add(N);return N;};
 auto Add=[&](UMaterialExpression* A,UMaterialExpression* B){auto N=NewObject<UMaterialExpressionAdd>(M);N->A.Expression=A;N->B.Expression=B;M->Expressions.Add(N);return N;};
 auto Sub=[&](UMaterialExpression* A,UMaterialExpression* B){auto N=NewObject<UMaterialExpressionSubtract>(M);N->A.Expression=A;N->B.Expression=B;M->Expressions.Add(N);return N;};
 auto Mul=[&](UMaterialExpression* A,UMaterialExpression* B){auto N=NewObject<UMaterialExpressionMultiply>(M);N->A.Expression=A;N->B.Expression=B;M->Expressions.Add(N);return N;};
 auto Abs=[&](UMaterialExpression* A){auto N=NewObject<UMaterialExpressionAbs>(M);N->Input.Expression=A;M->Expressions.Add(N);return N;};
 auto Sat=[&](UMaterialExpression* A){auto N=NewObject<UMaterialExpressionClamp>(M);N->Input.Expression=A;N->MinDefault=0;N->MaxDefault=1;M->Expressions.Add(N);return N;};
 auto Inv=[&](UMaterialExpression* A){auto N=NewObject<UMaterialExpressionOneMinus>(M);N->Input.Expression=A;M->Expressions.Add(N);return N;};
 auto Mask=[&](UMaterialExpression* A,bool Red){auto N=NewObject<UMaterialExpressionComponentMask>(M);N->Input.Expression=A;N->R=Red;N->G=!Red;M->Expressions.Add(N);return N;};
 auto Parameter=[&](FName Name,float Default){auto N=NewObject<UMaterialExpressionScalarParameter>(M);N->ParameterName=Name;N->DefaultValue=Default;M->Expressions.Add(N);return N;};
 auto UV=NewObject<UMaterialExpressionTextureCoordinate>(M);M->Expressions.Add(UV);auto X=Mask(UV,true),Y=Mask(UV,false);
 auto Time=NewObject<UMaterialExpressionTime>(M);M->Expressions.Add(Time);
 auto Sine=NewObject<UMaterialExpressionSine>(M);Sine->Input.Expression=Add(Mul(X,Add(Constant(3),Mul(Parameter(TEXT("Tuning"),0),Constant(14)))),Mul(Time,Constant(.8f)));Sine->Period=1;M->Expressions.Add(Sine);
 auto Search=Inv(Sat(Mul(Abs(Sub(Y,Add(Constant(.5),Mul(Sine,Constant(.16f))))),Constant(85))));
 // Right edge is NOW; the previous three seconds scroll to the left.
 auto SampleUV=NewObject<UMaterialExpressionAppendVector>(M);SampleUV->A.Expression=Add(Parameter(TEXT("BroadcastPhase"),0),Mul(Sub(X,Constant(1)),Constant(3.f/RecordingDuration)));SampleUV->B.Expression=Constant(.5);M->Expressions.Add(SampleUV);
 auto Sample=NewObject<UMaterialExpressionTextureSample>(M);Sample->Texture=Recording;Sample->SamplerType=SAMPLERTYPE_LinearColor;Sample->Coordinates.Expression=SampleUV;M->Expressions.Add(Sample);
 auto Top=Add(Constant(.5),Mul(Sub(Mask(Sample,true),Constant(.5)),Constant(.85f)));
 auto Bottom=Add(Constant(.5),Mul(Sub(Mask(Sample,false),Constant(.5)),Constant(.85f)));
 auto Body=Mul(Sat(Mul(Sub(Y,Top),Constant(180))),Sat(Mul(Sub(Bottom,Y),Constant(180))));
 auto Baseline=Mul(Inv(Sat(Mul(Abs(Sub(Y,Constant(.5))),Constant(160)))),Constant(.25));
 auto Playhead=Mul(Inv(Sat(Mul(Abs(Sub(X,Constant(.985))),Constant(350)))),Constant(.5));
 auto Trace=Sat(Add(Add(Mul(Body,Constant(.8)),Baseline),Playhead));
 auto Select=NewObject<UMaterialExpressionLinearInterpolate>(M);Select->A.Expression=Search;Select->B.Expression=Trace;Select->Alpha.Expression=Parameter(TEXT("Receiving"),0);M->Expressions.Add(Select);
 auto Green=NewObject<UMaterialExpressionConstant3Vector>(M);Green->Constant=FLinearColor(.12f,.9f,.42f);M->Expressions.Add(Green);
 auto Background=NewObject<UMaterialExpressionConstant3Vector>(M);Background->Constant=FLinearColor(.001f,.008f,.004f);M->Expressions.Add(Background);
 M->EmissiveColor.Expression=Add(Background,Mul(Mul(Select,Parameter(TEXT("Power"),0)),Green));M->Opacity.Expression=Constant(1);
 int32 LayoutIndex=0;for(auto Expression:M->Expressions){Expression->MaterialExpressionEditorX=(LayoutIndex%7)*340;Expression->MaterialExpressionEditorY=(LayoutIndex/7)*240;LayoutIndex++;}
 FAssetRegistryModule::AssetCreated(M);M->PostEditChange();Save(M);return M;
}
