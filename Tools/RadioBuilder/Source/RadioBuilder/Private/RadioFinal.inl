void PolishGraphs() {
 using namespace RadioBuild;
 for(auto Path:{TEXT("/Game/RadioExample/BP_RadioExample.BP_RadioExample"),TEXT("/Game/RadioExample/WBP_RadioDisplay.WBP_RadioDisplay")}) {
  auto B=LoadObject<UBlueprint>(nullptr,Path);check(B);
  for(auto& Variable:B->NewVariables) {
   FString N=Variable.VarName.ToString();
   Variable.Category=FText::FromString(N.Contains(TEXT("Mouse"))||N.Contains(TEXT("Drag"))?TEXT("Input"):N.Contains(TEXT("Sensitivity"))||N.Contains(TEXT("Station"))||N.Contains(TEXT("LockWidth"))?TEXT("Settings"):N.Contains(TEXT("Clip"))?TEXT("Audio"):TEXT("Radio State"));
  }
  for(auto G:B->FunctionGraphs)for(auto Node:G->Nodes)if(auto C=Cast<UK2Node_CallFunction>(Node))if(C->GetFunctionName()==TEXT("AsPercent_Float"))Def(C,TEXT("MaximumFractionalDigits"),TEXT("0"));
  Compile(B);
  TArray<UEdGraph*> Graphs=B->FunctionGraphs;Graphs.Append(B->UbergraphPages);
  for(auto G:Graphs) {int32 Index=0;for(auto N:G->Nodes) {N->Modify();N->NodePosX=(Index%5)*500;N->NodePosY=(Index/5)*380;Index++;if(Cast<UK2Node_FunctionEntry>(N)) {N->NodePosX=-500;N->NodePosY=0;N->NodeComment=G->GetName()+TEXT(" — см. раздел 11 UE5_ARCHITECTURE.md");N->bCommentBubbleVisible=true;}}
   G->NotifyGraphChanged();
  }
  B->MarkPackageDirty();Save(B);
 }
 // Lay out material expressions as well: the sample must remain editable for UI work.
 auto Material=LoadObject<UMaterial>(nullptr,TEXT("/Game/RadioExample/M_RadioWaveform.M_RadioWaveform"));check(Material);int32 MaterialIndex=0;
 for(auto Expression:Material->Expressions){Expression->MaterialExpressionEditorX=(MaterialIndex%7)*340;Expression->MaterialExpressionEditorY=(MaterialIndex/7)*240;MaterialIndex++;if(Cast<UMaterialExpressionTextureSample>(Expression))Expression->Desc=TEXT("Min/max PCM записи; X движется по AudioPhase");}
 Material->MarkPackageDirty();Save(Material);
 // Keep muted speech advancing; restoring Volume must not restart or lose it.
 for(auto Name:{TEXT("RadioSignal"),TEXT("RadioNoise")}) {
  auto Clip=LoadObject<USoundWave>(nullptr,*FString::Printf(TEXT("/Game/RadioExample/Audio/%s.%s"),Name,Name));check(Clip);
  Clip->VirtualizationMode=EVirtualizationMode::PlayWhenSilent;Clip->bLooping=true;Clip->MarkPackageDirty();Save(Clip);
 }
 // Integration checks execute the saved Blueprint, not a parallel implementation.
 FEditorScriptExecutionGuard ScriptGuard;
 auto BP=LoadObject<UBlueprint>(nullptr,TEXT("/Game/RadioExample/BP_RadioExample.BP_RadioExample"));auto Instance=GEditor->GetEditorWorldContext().World()->SpawnActor<AActor>(BP->GeneratedClass);
 auto SetNumber=[&](const TCHAR* N,double Value){auto P=FindFProperty<FDoubleProperty>(BP->GeneratedClass,N);check(P);P->SetPropertyValue_InContainer(Instance,Value);};
 auto ReadNumber=[&](const TCHAR* N){return FindFProperty<FDoubleProperty>(BP->GeneratedClass,N)->GetPropertyValue_InContainer(Instance);};
 auto Run=[&](const TCHAR* N){auto F=Instance->FindFunction(N);check(F);Instance->ProcessEvent(F,nullptr);};
 auto Object=[&](const TCHAR* N){return FindFProperty<FObjectProperty>(BP->GeneratedClass,N)->GetObjectPropertyValue_InContainer(Instance);};
 auto Screen=CastChecked<UWidgetComponent>(Object(TEXT("RadioScreen")));Screen->InitWidget();auto Widget=Screen->GetUserWidgetObject();check(Widget);FindFProperty<FObjectProperty>(Widget->GetClass(),TEXT("RadioReference"))->SetObjectPropertyValue_InContainer(Widget,Instance);
 auto Voice=CastChecked<UAudioComponent>(Object(TEXT("ReceiverAudio")));auto Noise=CastChecked<UAudioComponent>(Object(TEXT("InterferenceAudio")));
 int32 Checks=0;auto Expect=[&](bool Result,const TCHAR* Name){checkf(Result,TEXT("RADIO CHECK FAILED: %s"),Name);Checks++;UE_LOG(LogTemp,Display,TEXT("RADIO CHECK PASS: %s"),Name);};
 SetNumber(TEXT("DragDelta"),90);Run(TEXT("ApplyFilterDrag"));Expect(ReadNumber(TEXT("Filter"))==0,TEXT("Filter locked while OFF"));
 Run(TEXT("TogglePower"));Run(TEXT("ApplyFilterDrag"));Expect(ReadNumber(TEXT("Filter"))==0,TEXT("Filter locked while searching"));
 SetNumber(TEXT("FineFrequencyKHz"),153450);SetNumber(TEXT("DragDelta"),0);Run(TEXT("ApplyFrequencyDrag"));SetNumber(TEXT("Volume"),.8);
 for(double Filter:{0.,.5,1.}){SetNumber(TEXT("Filter"),Filter);Run(TEXT("UpdateAudioLevel"));Expect(FMath::IsNearlyEqual(Voice->VolumeMultiplier,.8f),TEXT("Locked filter preserves voice"));Expect(FMath::IsNearlyEqual(Noise->VolumeMultiplier,float(.8*(.6-.57*Filter))),TEXT("Locked filter attenuates interference"));}
 SetNumber(TEXT("FineFrequencyKHz"),153430);Run(TEXT("RefreshReception"));Expect(Voice->VolumeMultiplier==0,TEXT("Detuning mutes voice without Stop"));Expect(FMath::IsNearlyEqual(Noise->VolumeMultiplier,.48f),TEXT("Filter bypassed without station"));SetNumber(TEXT("DragDelta"),-90);Run(TEXT("ApplyFilterDrag"));Expect(ReadNumber(TEXT("Filter"))==1,TEXT("Lost station locks stored filter"));
 SetNumber(TEXT("FineFrequencyKHz"),153450);Run(TEXT("RefreshReception"));Expect(FMath::IsNearlyEqual(Voice->VolumeMultiplier,.8f)&&FMath::IsNearlyEqual(Noise->VolumeMultiplier,.024f),TEXT("Retuning restores reception and filter"));
 for(auto Pair:{TPair<const TCHAR*,const TCHAR*>(TEXT("Filter"),TEXT("ApplyFilterDrag")),{TEXT("Volume"),TEXT("ApplyVolumeDrag")}}){SetNumber(TEXT("DragDelta"),10000);Run(Pair.Value);Expect(ReadNumber(Pair.Key)==1,TEXT("Level upper clamp"));SetNumber(TEXT("DragDelta"),-10000);Run(Pair.Value);Expect(ReadNumber(Pair.Key)==0,TEXT("Level lower clamp"));}
 auto Camera=CastChecked<UCameraComponent>(Object(TEXT("ExampleCamera")));auto Project=[&](FVector P){auto D=P-Camera->GetComponentLocation();return FVector2D(FVector::DotProduct(D,Camera->GetRightVector()),-FVector::DotProduct(D,Camera->GetUpVector()))/FVector::DotProduct(D,Camera->GetForwardVector());};
 SetNumber(TEXT("FineFrequencyKHz"),153400);Run(TEXT("UpdatePresentation"));auto Anchor=CastChecked<USceneComponent>(Object(TEXT("InputCenter_Frequency")));
 auto MarkerAngle=[&](){auto D=Project(Anchor->GetComponentTransform().TransformPosition(FVector(1,0,0)))-Project(Anchor->GetComponentLocation());return FMath::RadiansToDegrees(FMath::Atan2(D.Y,D.X));};
 auto Before=MarkerAngle();SetNumber(TEXT("DragDelta"),90);Run(TEXT("ApplyFrequencyDrag"));auto VisualDelta=FMath::FindDeltaAngleDegrees(Before,MarkerAngle());UE_LOG(LogTemp,Display,TEXT("RADIO 1:1 VISUAL DELTA: %.3f degrees for 90 degree input"),VisualDelta);Expect(FMath::Abs(VisualDelta-90)<3,TEXT("Knob follows angle 1 to 1"));Expect(FMath::IsNearlyEqual(ReadNumber(TEXT("FineFrequencyKHz")),153418.75,0.001),TEXT("Frequency sensitivity reduced"));
 SetNumber(TEXT("DragDelta"),10000);Run(TEXT("ApplyFrequencyDrag"));Expect(ReadNumber(TEXT("FineFrequencyKHz"))==153550,TEXT("Frequency upper clamp"));SetNumber(TEXT("DragDelta"),-10000);Run(TEXT("ApplyFrequencyDrag"));Expect(ReadNumber(TEXT("FineFrequencyKHz"))==153400,TEXT("Frequency lower clamp"));
 Run(TEXT("InitializeBroadcast"));Run(TEXT("InitializeBroadcast"));Expect(FindFProperty<FIntProperty>(BP->GeneratedClass,TEXT("BroadcastStartCount"))->GetPropertyValue_InContainer(Instance)==1,TEXT("Broadcast initialized once"));Expect(Voice->Sound&&Noise->Sound,TEXT("Saved audio sources assigned"));
 Run(TEXT("TogglePower"));Expect(Voice->VolumeMultiplier==0&&Noise->VolumeMultiplier==0,TEXT("OFF silences both outputs"));
 Instance->Destroy();UE_LOG(LogTemp,Display,TEXT("RADIO VERIFICATION COMPLETE: %d checks"),Checks);UE_LOG(LogTemp,Display,TEXT("RADIO GRAPH LAYOUT COMPLETE"));

}

bool VerifyLivePIE() {
 static int Stage=0, Checks=0, Failed=0;static float Started=0;static double PhaseBefore=0;
 auto World=GEditor->PlayWorld;if(!World)return true;AActor* A=nullptr;for(TActorIterator<AActor> It(World);It;++It)if(It->GetClass()->GetName()==TEXT("BP_RadioExample_C"))A=*It;if(!A)return true;
 auto Class=A->GetClass();auto SetNum=[&](const TCHAR* N,double V){FindFProperty<FDoubleProperty>(Class,N)->SetPropertyValue_InContainer(A,V);};auto Num=[&](const TCHAR* N){return FindFProperty<FDoubleProperty>(Class,N)->GetPropertyValue_InContainer(A);};auto Flag=[&](const TCHAR* N){return FindFProperty<FBoolProperty>(Class,N)->GetPropertyValue_InContainer(A);};auto Run=[&](const TCHAR* N){A->ProcessEvent(A->FindFunction(N),nullptr);};
 auto Voice=CastChecked<UAudioComponent>(FindFProperty<FObjectProperty>(Class,TEXT("ReceiverAudio"))->GetObjectPropertyValue_InContainer(A));auto Noise=CastChecked<UAudioComponent>(FindFProperty<FObjectProperty>(Class,TEXT("InterferenceAudio"))->GetObjectPropertyValue_InContainer(A));
 auto Count=[&](){return FindFProperty<FIntProperty>(Class,TEXT("BroadcastStartCount"))->GetPropertyValue_InContainer(A);};auto Expect=[&](bool Good,const TCHAR* Label){Checks++;if(!Good)Failed++;UE_LOG(LogTemp,Display,TEXT("RADIO LIVE %s: %s phase=%.4f voice=%.3f noise=%.3f starts=%d"),Good?TEXT("PASS"):TEXT("FAIL"),Label,Num(TEXT("AudioPhase")),Voice->VolumeMultiplier,Noise->VolumeMultiplier,Count());};
 float Now=World->GetTimeSeconds();
 if(Stage==0&&Now>.5f){Started=Now;Expect(Count()==1,TEXT("One broadcast start at BeginPlay"));Expect(Voice->IsPlaying(),TEXT("Muted station is playing before tune"));SetNum(TEXT("DragDelta"),90);Run(TEXT("ApplyFilterDrag"));Expect(Num(TEXT("Filter"))==0,TEXT("Filter blocked before lock"));SetNum(TEXT("FineFrequencyKHz"),153450);SetNum(TEXT("DragDelta"),0);Run(TEXT("ApplyFrequencyDrag"));Run(TEXT("TogglePower"));SetNum(TEXT("Volume"),.8);SetNum(TEXT("DragDelta"),180);Run(TEXT("ApplyFilterDrag"));Expect(Flag(TEXT("Receiving"))&&FMath::IsNearlyEqual(Num(TEXT("Filter")),.5,0.001),TEXT("Filter active after lock"));Stage=1;}
 else if(Stage==1&&Now>Started+1.2f){Expect(Flag(TEXT("HasAudioPhase"))&&Num(TEXT("AudioPhase"))>0,TEXT("Real audio callback drives waveform"));PhaseBefore=Num(TEXT("AudioPhase"));SetNum(TEXT("FineFrequencyKHz"),153430);SetNum(TEXT("DragDelta"),0);Run(TEXT("ApplyFrequencyDrag"));Expect(!Flag(TEXT("Receiving"))&&Voice->IsPlaying()&&Voice->VolumeMultiplier==0,TEXT("Detuned voice keeps playing muted"));Stage=2;}
