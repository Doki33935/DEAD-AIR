void FitRadioMesh(UStaticMesh* New,UStaticMesh* Old){
 auto A=New->GetBoundingBox(),B=Old->GetBoundingBox();TArray<FVector> Source,Target;FStaticMeshAttributes NA(*New->GetMeshDescription(0)),OA(*Old->GetMeshDescription(0));auto NP=NA.GetVertexPositions(),OP=OA.GetVertexPositions();for(auto I:New->GetMeshDescription(0)->Vertices().GetElementIDs())Source.Add((FVector(NP[I])-A.GetCenter())/A.GetSize());for(auto I:Old->GetMeshDescription(0)->Vertices().GetElementIDs())Target.Add((FVector(OP[I])-B.GetCenter())/B.GetSize());
 int Permutations[6][3]={{0,1,2},{0,2,1},{1,0,2},{1,2,0},{2,0,1},{2,1,0}};int Parity[6]={1,-1,-1,1,1,-1};double Best=MAX_dbl;int BestP=0,BestS=0;for(int P=0;P<6;P++)for(int S=0;S<8;S++){TArray<FVector> Candidate;for(auto V:Source)Candidate.Add(FVector(V[Permutations[P][0]]*((S&1)?-1:1),V[Permutations[P][1]]*((S&2)?-1:1),V[Permutations[P][2]]*((S&4)?-1:1)));double Sum=0;for(auto V:Candidate){double Nearest=MAX_dbl;for(auto T:Target)Nearest=FMath::Min(Nearest,(V-T).SizeSquared());Sum+=Nearest/Candidate.Num();}for(auto T:Target){double Nearest=MAX_dbl;for(auto V:Candidate)Nearest=FMath::Min(Nearest,(V-T).SizeSquared());Sum+=Nearest/Target.Num();}if(Sum<Best-1.e-10){Best=Sum;BestP=P;BestS=S;}}
