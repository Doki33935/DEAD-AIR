UEdGraph* AnyGraph(UBlueprint* BP,const TCHAR* Name){TArray<UEdGraph*> GS;BP->GetAllGraphs(GS);for(auto G:GS)if(G->GetFName()==Name)return G;return nullptr;}
UBlueprint* Make(const TCHAR* Name,UClass* Parent,EBlueprintType Kind=BPTYPE_Normal){auto Path=FString(TEXT("/Game/Interaction/"))+Name;if(auto B=LoadObject<UBlueprint>(nullptr,*Path))return B;auto B=FKismetEditorUtilities::CreateBlueprint(Parent,CreatePackage(*Path),Name,Kind,UBlueprint::StaticClass(),UBlueprintGeneratedClass::StaticClass());FAssetRegistryModule::AssetCreated(B);return B;}
UEdGraph* Signature(UBlueprint* BP,const TCHAR* Name,std::initializer_list<TPair<const TCHAR*,FEdGraphPinType>> Inputs,FEdGraphPinType Output){UK2Node_FunctionEntry* E;auto G=Fun(BP,Name,E);for(auto P:Inputs)E->CreateUserDefinedPin(P.Key,P.Value,EGPD_Output);auto R=Node<UK2Node_FunctionResult>(G);R->FunctionReference.SetSelfMember(Name);R->AllocateDefaultPins();R->CreateUserDefinedPin(TEXT("ReturnValue"),Output,EGPD_Input);Link(Pin(E,TEXT("then")),Pin(R,TEXT("execute")));return G;}
UEdGraph* Body(UBlueprint* BP,const TCHAR* Name,UEdGraphPin*& X){auto G=AnyGraph(BP,Name);check(G);RadioBuild::Position=0;auto E=Entry(G);auto Nodes=G->Nodes;for(auto N:Nodes)if(N!=E)FBlueprintEditorUtils::RemoveNode(BP,N,true);X=Pin(E,TEXT("then"));return G;}
void Return(UEdGraph* G,UEdGraphPin* X,const TCHAR* Name,FEdGraphPinType T,UEdGraphPin* Value=nullptr,const TCHAR* Default=nullptr){auto R=Node<UK2Node_FunctionResult>(G);R->FunctionReference.SetSelfMember(Name);R->AllocateDefaultPins();auto P=R->FindPin(TEXT("ReturnValue"));if(!P)P=R->CreateUserDefinedPin(TEXT("ReturnValue"),T,EGPD_Input);Link(X,Pin(R,TEXT("execute")));if(Value)Link(Value,P);if(Default)Schema->TrySetDefaultValue(*P,Default);}
UK2Node_Message* Message(UEdGraph* G,UEdGraphPin*& X,const TCHAR* Name,UEdGraphPin* Target){auto M=Node<UK2Node_Message>(G);M->SetFromFunction(Contract->GeneratedClass->FindFunctionByName(Name));M->AllocateDefaultPins();Link(Target,Pin(M,TEXT("self")));Link(X,Pin(M,TEXT("execute")));X=Pin(M,TEXT("then"));return M;}
UK2Node_MacroInstance* Each(UEdGraph* G,UEdGraphPin* X,UEdGraphPin* Array){auto Standard=LoadObject<UBlueprint>(nullptr,TEXT("/Engine/EditorBlueprintResources/StandardMacros.StandardMacros"));check(Standard);UEdGraph* Loop=nullptr;for(auto M:Standard->MacroGraphs)if(M->GetFName()==TEXT("ForEachLoop"))Loop=M;check(Loop);auto N=Node<UK2Node_MacroInstance>(G);N->SetMacroGraph(Loop);N->AllocateDefaultPins();Link(X,Pin(N,TEXT("Exec")));Link(Array,Pin(N,TEXT("Array")));return N;}
UEdGraphPin* IsInstrument(UEdGraph* G,UEdGraphPin* Object){auto C=Call(G,UKismetSystemLibrary::StaticClass(),TEXT("DoesImplementInterface"));Link(Object,Pin(C,TEXT("TestObject")));Pin(C,TEXT("Interface"))->DefaultObject=Contract->GeneratedClass;return Pin(C,TEXT("ReturnValue"));}
