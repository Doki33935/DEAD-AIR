 while(Queue.Num()){auto N=Queue.Pop();if(Live.Contains(N))continue;Live.Add(N);for(auto P:N->Pins){bool DataInput=P->Direction==EGPD_Input&&P->PinType.PinCategory!=UEdGraphSchema_K2::PC_Exec;bool FlowOutput=P->Direction==EGPD_Output&&P->PinType.PinCategory==UEdGraphSchema_K2::PC_Exec;if(DataInput||FlowOutput)for(auto L:P->LinkedTo)Queue.Add(L->GetOwningNode());}}
 auto Nodes=G->Nodes;for(auto N:Nodes)if(!Live.Contains(N))FBlueprintEditorUtils::RemoveNode(BP,N,true);
}
