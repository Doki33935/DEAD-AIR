// Structural and input checks for the new ownership boundary, in a real PIE world.
namespace InteractionVerify {
using namespace MenuVerify;
bool Tick(){
 static int Stage=0,Checks=0,Failed=0;static bool Requested=false,Prefixed=false;static double At=0,Started=FPlatformTime::Seconds();static FString Prefix=FString::Printf(TEXT("DA_INTERACT_QA_%lld"),FDateTime::Now().GetTicks());
 auto Now=FPlatformTime::Seconds();auto Expect=[&](bool Good,const TCHAR* Label){Checks++;if(!Good)Failed++;UE_LOG(LogTemp,Display,TEXT("INTERACTION VERIFY %s: %s"),Good?TEXT("PASS"):TEXT("FAIL"),Label);};auto Finish=[&](){UE_LOG(LogTemp,Display,TEXT("INTERACTION VERIFY COMPLETE: %d checks, %d failures"),Checks,Failed);Stage=99;At=Now;GEditor->RequestEndPlayMap();};
 if(Stage==99){if(!GEditor->PlayWorld&&Now>At+2){FPlatformMisc::RequestExit(false);return false;}return true;}if(Now-Started>100){Expect(false,TEXT("Runtime timeout"));Finish();return true;}
 if(!Requested){GetMutableDefault<UEditorPerformanceSettings>()->bThrottleCPUWhenNotForeground=false;FRequestPlaySessionParams P;P.GlobalMapOverride=TEXT("/Game/UI/MainMenuMap");GEditor->RequestPlaySession(P);Requested=true;return true;}
 auto W=GEditor->PlayWorld;if(!W)return true;if(!Prefixed&&W->GetGameInstance()){String(W->GetGameInstance(),TEXT("StoragePrefix"),Prefix);Prefixed=true;}
 auto PC=UGameplayStatics::GetPlayerController(W,0);auto Manager=InteractionAccess::Find(PC,TEXT("BP_MenuManager_C"));if(!Manager||!Obj(Manager,TEXT("View")))return true;
 if(Stage==0){String(Manager,TEXT("StoragePrefix"),Prefix);Run(Manager,TEXT("StartNewGame"));Stage=1;At=Now;return true;}
 auto Rig=InteractionAccess::Find(PC,TEXT("BP_DeskWorkstationRig_C"));auto RadioActor=InteractionAccess::Find(PC,TEXT("BP_RadioIntegrated_C"));auto DeckActor=InteractionAccess::Find(PC,TEXT("BP_TapeDeckIntegrated_C"));if(!Rig||!RadioActor||!DeckActor||!Obj(PC,TEXT("View")))return true;
 auto Contract=LoadObject<UBlueprint>(nullptr,TEXT("/Game/Interaction/BPI_Instrument"));auto Mode=[&](){return FindFProperty<FIntProperty>(Rig->GetClass(),TEXT("CameraMode"))->GetPropertyValue_InContainer(Rig);};
 if(Stage==1&&Now>At+3){
  Expect(PC->GetClass()->GetName()==TEXT("BP_OperatorController_C"),TEXT("The game spawns the dedicated mouse interaction controller"));Expect(RadioActor->GetClass()->ImplementsInterface(Contract->GeneratedClass)&&DeckActor->GetClass()->ImplementsInterface(Contract->GeneratedClass),TEXT("Both instruments implement the same contract"));
  auto BP=CastChecked<UBlueprint>(Rig->GetClass()->ClassGeneratedBy);bool DeviceFree=true;for(auto Vv:BP->NewVariables)if(Vv.VarName==TEXT("RadioReference")||Vv.VarName==TEXT("DeckReference")||Vv.VarName==TEXT("View"))DeviceFree=false;Expect(DeviceFree,TEXT("Camera rig has no device or HUD member references"));
  bool CameraOnly=true;TArray<UEdGraph*> GS;BP->GetAllGraphs(GS);for(auto G:GS)for(auto N:G->Nodes)if(auto C=Cast<UK2Node_CallFunction>(N))if(C->GetFunctionName()==TEXT("LineTraceSingle")||C->GetFunctionName()==TEXT("SetCollisionEnabled")||C->GetFunctionName()==TEXT("WasInputKeyJustPressed"))CameraOnly=false;Expect(CameraOnly,TEXT("Camera graph contains no selection trace, click dispatch or button gates"));
  BP=CastChecked<UBlueprint>(PC->GetClass()->ClassGeneratedBy);bool Generic=true;for(auto Vv:BP->NewVariables){auto T=Vv.VarType.PinSubCategoryObject.Get();if(T==RadioActor->GetClass()||T==DeckActor->GetClass())Generic=false;}Expect(Generic,TEXT("Controller stores interface targets without concrete radio/deck types"));
  BP=LoadObject<UBlueprint>(nullptr,TEXT("/Game/RadioExample/BP_RadioExample"));bool RadioOnly=true;GS.Empty();BP->GetAllGraphs(GS);for(auto G:GS)for(auto N:G->Nodes){if(auto C=Cast<UK2Node_CallFunction>(N))if(C->GetFunctionName()==TEXT("SetViewTargetWithBlend")||C->GetFunctionName()==TEXT("SetInputMode_GameAndUIEx"))RadioOnly=false;if(auto S=Cast<UK2Node_VariableSet>(N))if(S->GetVarName()==TEXT("bShowMouseCursor")||S->GetVarName()==TEXT("bEnableClickEvents"))RadioOnly=false;}Expect(RadioOnly,TEXT("Radio no longer sets player viewport, input mode or cursor"));
  Expect(Mode()==0&&!PC->bShowMouseCursor&&!Flag(DeckActor,TEXT("ControlsEnabled")),TEXT("Initial overview has a hidden cursor and no live transport keys"));Expect(!InteractionAccess::FocusActor(PC,nullptr)&&Mode()==0,TEXT("Null instrument is rejected without changing camera"));auto Invalid=W->SpawnActor<AActor>();Expect(!InteractionAccess::FocusActor(PC,Invalid)&&Mode()==0,TEXT("Actor without interface is rejected"));Invalid->Destroy();Expect(!InteractionAccess::FocusActor(PC,Invalid),TEXT("Destroyed actor is rejected"));
  // Freeze only the overview motion for deterministic trace/input assertions; camera timers still run.
  Rig->SetActorTickEnabled(false);auto View=CastChecked<UChildActorComponent>(Obj(Rig,TEXT("ViewCenter")));auto Body=CastChecked<UStaticMeshComponent>(Obj(RadioActor,TEXT("Radio_Body")));View->SetWorldRotation((Body->Bounds.Origin-View->GetComponentLocation()).Rotation());PC->PlayerCameraManager->UpdateCamera(.016f);InteractionAccess::Gaze(PC);Expect(Obj(PC,TEXT("HoveredInstrument"))==RadioActor,TEXT("Real controller gaze trace selects the radio interface"));PC->InputKey(FInputKeyParams(EKeys::LeftMouseButton,IE_Pressed,1,false));At=Now;Stage=2;return true;
 }
 if(Stage==2&&Now>At+.2){PC->InputKey(FInputKeyParams(EKeys::LeftMouseButton,IE_Released,0,false));Expect(Obj(PC,TEXT("ActiveInstrument"))==RadioActor&&Mode()==1,TEXT("LMB input dispatches gaze selection through the production controller"));Expect(!Flag(RadioActor,TEXT("Powered")),TEXT("The focus click does not also press the power button"));Expect(!InteractionAccess::FocusActor(PC,DeckActor),TEXT("A second focus request is blocked during the blend"));At=Now;Stage=3;return true;}
 if(Stage==3&&Now>At+.6){Expect(PC->bShowMouseCursor&&!Flag(DeckActor,TEXT("ControlsEnabled")),TEXT("Radio focus shows cursor and keeps other instrument disabled"));Expect(!InteractionAccess::FocusActor(PC,RadioActor),TEXT("Repeated focus on the active instrument is rejected"));bool Enabled=true;for(auto Name:{TEXT("Click_Frequency"),TEXT("Click_Gain"),TEXT("Click_Volume"),TEXT("Click_Power")})Enabled&=CastChecked<UPrimitiveComponent>(Obj(RadioActor,Name))->GetCollisionEnabled()==ECollisionEnabled::QueryOnly;Expect(Enabled,TEXT("Radio owns and enables its own four controls"));Expect(PC->GetViewTarget()==CastChecked<UChildActorComponent>(Obj(RadioActor,TEXT("InteractionView")))->GetChildActor(),TEXT("Camera uses the instrument-owned focus anchor"));PC->InputKey(FInputKeyParams(EKeys::RightMouseButton,IE_Pressed,1,false));At=Now;Stage=4;return true;}
 if(Stage==4&&Now>At+.7){PC->InputKey(FInputKeyParams(EKeys::RightMouseButton,IE_Released,0,false));Expect(Mode()==0&&!PC->bShowMouseCursor&&!Obj(PC,TEXT("ActiveInstrument")),TEXT("RMB input returns to desk, clears active target and hides cursor"));Expect(InteractionAccess::FocusActor(PC,DeckActor),TEXT("The same API focuses the cassette deck"));At=Now;Stage=5;return true;}
 if(Stage==5&&Now>At+.6){Expect(Flag(DeckActor,TEXT("ControlsEnabled"))&&PC->bShowMouseCursor,TEXT("Deck focus enables physical transport after the blend"));Expect(CastChecked<UPrimitiveComponent>(Obj(RadioActor,TEXT("Click_Power")))->GetCollisionEnabled()==ECollisionEnabled::NoCollision,TEXT("Radio buttons are disabled while the deck is focused"));Run(Manager,TEXT("OpenPause"));Expect(!InteractionAccess::FocusActor(PC,RadioActor),TEXT("Menu pause prevents instrument focus"));Run(Manager,TEXT("ResumeGame"));At=Now;Stage=6;return true;}
 if(Stage==6&&Now>At+.3){Expect(Flag(DeckActor,TEXT("ControlsEnabled")),TEXT("Returning from menu restores only the active instrument gates"));InteractionAccess::Back(PC);At=Now;Stage=7;return true;}
 if(Stage==7&&Now>At+.6){Expect(Mode()==0&&!Flag(DeckActor,TEXT("ControlsEnabled")),TEXT("Repeated focus/return cycle leaves the desk ready"));Finish();return true;}
 return true;
}
}
